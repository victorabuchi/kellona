// use prisma-8

// Tenant model: every row that belongs to a customer carries organizationId.
// Kinds and statuses are plain strings, validated in code (src/lib/*-kinds.ts).

model Organization {
  id                  Uuid                @id @default(uuid())
  slug                String              @unique
  name                String
  shortName           String
  // 'active' | 'pilot' | 'suspended'
  status              String              @default("pilot")
  // Marks organizations that exist only to demo and test the product.
  isDemo              Boolean             @default(false)
  defaultLocale       String              @default("fi")
  // Comma separated, for example "fi,en".
  locales             String              @default("fi,en")
  timezone            String              @default("Europe/Helsinki")
  supportEmail        String?
  supportPhone        String?
  supportUrl          String?
  // Data controller details used on the privacy and terms pages.
  legalName           String?
  businessId          String?
  address             String?
  privacyEmail        String?
  // Name shown as the sender of emails and push notifications.
  senderName          String?
  createdAt           TimestamptzString   @default(now())
  domains             OrgDomain[]
  brand               OrgBrand?
  texts               OrgText[]
  buildings           Building[]
  units               Unit[]
  residents           Resident[]
  staff               Staff[]
  staffBuildings      StaffBuilding[]
  identities          AuthIdentity[]
  facilities          Facility[]
  buildingAmenities   BuildingAmenity[]
  unitAmenities       UnitAmenity[]
  bookings            Booking[]
  participants        BookingParticipant[]
  parkingClaims       ParkingClaim[]
  pushSubscriptions   PushSubscription[]
  releases            BookingRelease[]
  watches             SlotWatch[]
  contacts            OrgContact[]
  helpArticles        HelpArticle[]
  reports             FaultReport[]

  @@map("organization")
}

// A web address that serves one organization, such as a customer subdomain or
// a custom domain. Platform subdomains (<slug>.kellona.fi) need no row.
model OrgDomain {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  host           String            @unique
  isPrimary      Boolean           @default(false)
  // Proof of ownership: a TXT record _kellona.<host> = kellona-verification=<token>.
  // Only verified domains serve the organization.
  verificationToken String?
  verifiedAt     TimestamptzString?
  lastCheckedAt  TimestamptzString?
  lastError      String?
  createdAt      TimestamptzString @default(now())

  @@index([organizationId])
  @@map("org_domain")
}

model OrgBrand {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid              @unique
  logoLightUrl   String?
  logoDarkUrl    String?
  faviconUrl     String?
  // Square icon for the installable app. Falls back to the favicon.
  appIconUrl     String?
  primaryColor   String            @default("#2f5d8a")
  accentColor    String            @default("#e0a526")
  updatedAt      TimestamptzString @default(now())

  @@map("org_brand")
}

// Per organization text overrides on top of the built in Finnish and English.
model OrgText {
  id             Uuid         @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  locale         String
  key            String
  value          String

  @@unique([organizationId, locale, key])
  @@map("org_text")
}

model Building {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  name           String
  address        String?
  // Neighbourhood the building belongs to (for example a district), used to group buildings.
  area           String?
  // Identifier in the customer's own system, used to match CSV imports.
  externalRef    String?
  createdAt      TimestamptzString @default(now())
  units          Unit[]
  facilities     Facility[]
  amenities      BuildingAmenity[]
  staffLinks     StaffBuilding[]

  @@unique([organizationId, name])
  @@map("building")
}

model Unit {
  id             Uuid          @id @default(uuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  building       Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId     Uuid
  code           String
  floor          Int?
  externalRef    String?
  residents      Resident[]
  amenities      UnitAmenity[]

  @@unique([buildingId, code])
  @@index([organizationId])
  @@map("unit")
}

model Resident {
  id                Uuid                 @id @default(uuid())
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    Uuid
  unit              Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId            Uuid?
  name              String
  email             String
  locale            String?
  externalRef       String?
  // 'active' | 'moved_out'
  status            String               @default("active")
  createdAt         TimestamptzString    @default(now())
  identities        AuthIdentity[]
  bookings          Booking[]
  participations    BookingParticipant[]
  parkingClaim      ParkingClaim?
  pushSubscriptions PushSubscription[]
  releases          BookingRelease[]
  watches           SlotWatch[]
  reports           FaultReport[]

  @@unique([organizationId, email])
  @@index([unitId])
  @@map("resident")
}

model Staff {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  name           String
  email          String
  // 'manager' sees every building, 'staff' only linked buildings.
  role           String            @default("staff")
  createdAt      TimestamptzString @default(now())
  buildings      StaffBuilding[]
  identities     AuthIdentity[]

  @@unique([organizationId, email])
  @@map("staff")
}

model StaffBuilding {
  id             Uuid         @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId        Uuid
  building       Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId     Uuid

  @@unique([staffId, buildingId])
  @@map("staff_building")
}

// A verified way to sign in. provider is 'email', 'google', or 'oidc:<name>' /
// 'saml:<name>' for an organization's own single sign-on later.
model AuthIdentity {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  provider       String
  subject        String
  resident       Resident?         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid?
  staff          Staff?            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId        Uuid?
  // scrypt hash, only for provider 'password'.
  secretHash     String?
  createdAt      TimestamptzString @default(now())
  lastUsedAt     TimestamptzString?

  @@unique([organizationId, provider, subject])
  @@map("auth_identity")
}

// One bookable thing: a laundry machine, a sauna, a parking spot or a space.
// kind is one of AMENITY_KINDS. Rule columns are filled from per kind defaults
// and can be tuned per facility by staff.
model Facility {
  id                 Uuid              @id @default(uuid())
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId     Uuid
  building           Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId         Uuid
  kind               String
  name               String
  description        String?
  capacity           Int               @default(1)
  openHour           Int               @default(8)
  closeHour          Int               @default(22)
  // Fixed turn starts such as "16,18,20". Empty means any hour in opening hours.
  turnStartHours     String?
  slotHours          Int               @default(1)
  maxHoursPerBooking Int               @default(2)
  maxHoursPerWeek    Int               @default(4)
  advanceDays        Int               @default(7)
  // Bookings can be cancelled until this many minutes before they start. 0 = any time.
  cancelCutoffMinutes Int              @default(0)
  // How many weeks a booking can repeat (standing weekly turn). 1 = no repeating.
  maxRepeatWeeks     Int               @default(1)
  // Check-in: opens this many minutes before the start (0 = no check-in) and
  // stays open this many minutes after it. Unclaimed bookings are released.
  checkInOpensMinutes Int              @default(0)
  checkInGraceMinutes Int              @default(15)
  // Staff switch: blocks new bookings and shows residents the note.
  outOfOrder         Boolean           @default(false)
  outOfOrderNote     String?
  sortOrder          Int               @default(0)
  createdAt          TimestamptzString @default(now())
  bookings           Booking[]
  parkingClaim       ParkingClaim?
  releases           BookingRelease[]
  watches            SlotWatch[]
  reports            FaultReport[]

  @@unique([buildingId, name])
  @@index([organizationId])
  @@map("facility")
}

// 'yes' / 'no' per building and kind. No row means automatic.
model BuildingAmenity {
  id             Uuid         @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  building       Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId     Uuid
  kind           String
  enabled        Boolean

  @@unique([buildingId, kind])
  @@map("building_amenity")
}

// Apartment level exception, wins over the building setting.
model UnitAmenity {
  id             Uuid         @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId         Uuid
  kind           String
  enabled        Boolean

  @@unique([unitId, kind])
  @@map("unit_amenity")
}

model Booking {
  id             Uuid                 @id @default(uuid())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  facility       Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     Uuid
  resident       Resident             @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid
  startsAt       TimestamptzString
  endsAt         TimestamptzString
  note           String?
  // Shared by every week of a standing weekly turn.
  seriesId       Uuid?
  reminderSentAt TimestamptzString?
  // Set when the booker checks in (QR). Past bookings without it count as no-shows.
  checkedInAt    TimestamptzString?
  checkInReminderSentAt TimestamptzString?
  createdAt      TimestamptzString    @default(now())
  participants   BookingParticipant[]

  @@unique([facilityId, startsAt])
  @@index([organizationId, startsAt])
  @@index([residentId])
  @@map("booking")
}

model BookingParticipant {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId      Uuid
  resident       Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid
  // 'invited' | 'accepted' | 'declined'
  status         String            @default("invited")
  createdAt      TimestamptzString @default(now())

  @@unique([bookingId, residentId])
  @@index([residentId])
  @@map("booking_participant")
}

// A resident holds at most one parking spot, and a spot has at most one holder.
model ParkingClaim {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  facility       Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     Uuid              @unique
  resident       Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid              @unique
  claimedAt      TimestamptzString @default(now())

  @@map("parking_claim")
}

model PushSubscription {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  resident       Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid
  endpoint       String            @unique
  p256dh         String
  auth           String
  createdAt      TimestamptzString @default(now())

  @@index([residentId])
  @@map("push_subscription")
}

// Platform level, not organization owned: Kellona's own super-admins.
model PlatformAdmin {
  id           Uuid               @id @default(uuid())
  email        String             @unique
  name         String
  passwordHash String?
  createdAt    TimestamptzString  @default(now())
  lastSignInAt TimestamptzString?

  @@map("platform_admin")
}

// One-time sign-in link. organizationId is null for platform admins, which is
// why this table is not in orgScope. Only a hash of the token is stored.
model LoginToken {
  id             Uuid               @id @default(uuid())
  tokenHash      String             @unique
  email          String
  organizationId Uuid?
  expiresAt      TimestamptzString
  usedAt         TimestamptzString?
  createdAt      TimestamptzString  @default(now())

  @@index([email])
  @@map("login_token")
}

// Platform level: a housing organization asking for a Kellona pilot via /signup.
model AccessRequest {
  id               Uuid              @id @default(uuid())
  organizationName String
  contactName      String
  email            String
  phone            String?
  residents        Int?
  message          String?
  locale           String            @default("fi")
  // 'new' | 'contacted' | 'closed'
  status           String            @default("new")
  createdAt        TimestamptzString @default(now())

  @@index([createdAt])
  @@map("access_request")
}

// A booking released because nobody checked in. Kept for staff no-show reports.
model BookingRelease {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  facility       Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     Uuid
  resident       Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid
  startsAt       TimestamptzString
  endsAt         TimestamptzString
  releasedAt     TimestamptzString @default(now())

  @@index([organizationId, startsAt])
  @@index([residentId])
  @@map("booking_release")
}

// "Notify me if this time frees up" on a booked slot.
model SlotWatch {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  facility       Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     Uuid
  resident       Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid
  startsAt       TimestamptzString
  createdAt      TimestamptzString @default(now())

  @@unique([facilityId, startsAt, residentId])
  @@index([residentId])
  @@map("slot_watch")
}

// Ways to reach the organization, shown to residents on the Contact page.
model OrgContact {
  id             Uuid         @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  title          String
  description    String?
  phone          String?
  email          String?
  url            String?
  hours          String?
  // Shown first and highlighted, for example a 24/7 maintenance line.
  emergency      Boolean      @default(false)
  sortOrder      Int          @default(0)

  @@index([organizationId])
  @@map("org_contact")
}

// House rules and answers the organization writes for its residents.
model HelpArticle {
  id             Uuid              @id @default(uuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  locale         String            @default("fi")
  title          String
  body           String
  sortOrder      Int               @default(0)
  updatedAt      TimestamptzString @default(now())

  @@index([organizationId])
  @@map("help_article")
}

// A resident's report about a facility or their building. 'new' | 'in_progress' | 'done'.
model FaultReport {
  id             Uuid               @id @default(uuid())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Uuid
  resident       Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentId     Uuid
  facility       Facility?          @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  facilityId     Uuid?
  buildingId     Uuid?
  category       String             @default("broken")
  message        String
  status         String             @default("new")
  staffNote      String?
  createdAt      TimestamptzString  @default(now())
  updatedAt      TimestamptzString  @default(now())
  resolvedAt     TimestamptzString?

  @@index([organizationId, status])
  @@index([residentId])
  @@map("fault_report")
}
