# Postgres >= 15. Local: `npm run db:local` starts one on port 54329.
# Supabase session pooler: the user name must be postgres.<project-ref>.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/kellona"

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Hosts that serve organizations as <slug>.<platform domain>.
PLATFORM_DOMAINS="kellona.fi,kellona.com"



CRON_SECRET=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@kellona.fi"
RESEND_API_KEY=""
RESEND_FROM="Kellona <noreply@kellona.fi>"
TZ="Europe/Helsinki"

# Contact shown on Kellona's own site (landing footer, privacy page).
KELLONA_CONTACT_EMAIL=""
