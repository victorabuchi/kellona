{
  "name": "kellona",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "db:local": "tsx scripts/local-db.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "setup": "prisma contract emit && prisma db migrate && tsx scripts/seed-demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "screenshot": "tsx scripts/screenshot.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.10",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "8.0.0-rc.10",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd": false,
    "msgpackr-extract": false
  }
}
